{
  "name": "@hollow-march/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.test.json && node --test .test-dist/test/*.test.js",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@colyseus/core": "^0.17.32",
    "@colyseus/redis-driver": "^0.17.6",
    "@colyseus/redis-presence": "^0.18.2",
    "@colyseus/schema": "^4.0.31",
    "@colyseus/ws-transport": "^0.17.9",
    "@hollow-march/shared": "workspace:*",
    "@hearthmere/content": "workspace:*",
    "express": "^5.1.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.5.2",
    "@types/pg": "^8.15.5"
  }
}
