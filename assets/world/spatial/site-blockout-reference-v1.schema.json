{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "assets/world/spatial/site-blockout-reference-v1.schema.json",
  "title": "Sable Reach site-local blockout reference v1",
  "description": "A bounded, noncanonical spatial handoff that binds canonical and accepted quest sources without asserting production geometry.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "siteId",
    "title",
    "claims",
    "authority",
    "sourceBindings",
    "spatialReference",
    "anchorPlacements",
    "structures",
    "thresholds",
    "egress",
    "utilities",
    "hazards",
    "habitats",
    "routes",
    "activityPhases",
    "questCrosswalk",
    "artDirection"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^site-blockout\\." },
    "siteId": { "type": "string", "pattern": "^site\\." },
    "title": { "type": "string", "minLength": 1 },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical",
        "runtimeIntegrated",
        "constructionReady",
        "productionGeometry",
        "atlasExportEligible",
        "releaseReady",
        "authorSelfApproval",
        "integrationAuthorized"
      ],
      "properties": {
        "canonical": { "const": false },
        "runtimeIntegrated": { "const": false },
        "constructionReady": { "const": false },
        "productionGeometry": { "const": false },
        "atlasExportEligible": { "const": false },
        "releaseReady": { "const": false },
        "authorSelfApproval": { "const": false },
        "integrationAuthorized": { "const": false }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification", "precedence", "consumer", "relocationRule"],
      "properties": {
        "classification": { "const": "noncanonical_site_local_reference" },
        "precedence": { "type": "array", "minItems": 3, "items": { "type": "string" } },
        "consumer": { "type": "string", "minLength": 1 },
        "relocationRule": { "type": "string", "minLength": 1 }
      }
    },
    "sourceBindings": {
      "type": "array",
      "minItems": 3,
      "items": { "$ref": "#/$defs/sourceBinding" }
    },
    "spatialReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coordinateSpaceId",
        "coordinateSemantics",
        "axes",
        "unit",
        "atlasSiteAnchor",
        "localOriginAtlasCoordinate",
        "localBoundsMeters",
        "placementStatus",
        "precisionNotice"
      ],
      "properties": {
        "coordinateSpaceId": { "const": "veyl_local_grid_v1" },
        "coordinateSemantics": { "const": "candidate_site_local_fictional_meters" },
        "axes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y", "z"],
          "properties": {
            "x": { "const": "local east" },
            "y": { "const": "local north" },
            "z": { "const": "local up" }
          }
        },
        "unit": { "const": "meter" },
        "atlasSiteAnchor": { "$ref": "#/$defs/vector3" },
        "localOriginAtlasCoordinate": { "$ref": "#/$defs/vector3" },
        "localBoundsMeters": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minimum", "maximum"],
          "properties": {
            "minimum": { "$ref": "#/$defs/vector3" },
            "maximum": { "$ref": "#/$defs/vector3" }
          }
        },
        "placementStatus": { "const": "candidate_relocatable_not_atlas_geometry" },
        "precisionNotice": { "type": "string", "minLength": 1 }
      }
    },
    "anchorPlacements": {
      "type": "array",
      "minItems": 18,
      "maxItems": 18,
      "items": { "$ref": "#/$defs/anchorPlacement" }
    },
    "structures": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "$ref": "#/$defs/structure" }
    },
    "thresholds": {
      "type": "array",
      "minItems": 10,
      "items": { "$ref": "#/$defs/threshold" }
    },
    "egress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["originAnchorId", "paths", "independenceRule"],
      "properties": {
        "originAnchorId": { "type": "string" },
        "paths": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "$ref": "#/$defs/egressPath" }
        },
        "independenceRule": { "type": "string", "minLength": 1 }
      }
    },
    "utilities": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": { "$ref": "#/$defs/utility" }
    },
    "hazards": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": { "$ref": "#/$defs/hazard" }
    },
    "habitats": {
      "type": "array",
      "minItems": 3,
      "items": { "$ref": "#/$defs/habitat" }
    },
    "routes": {
      "type": "array",
      "minItems": 7,
      "items": { "$ref": "#/$defs/route" }
    },
    "activityPhases": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/activityPhase" }
    },
    "questCrosswalk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["questId", "locationId", "questRecordSha256", "environmentProgramSha256", "bindingMode", "objectives"],
      "properties": {
        "questId": { "type": "string" },
        "locationId": { "type": "string" },
        "questRecordSha256": { "$ref": "#/$defs/sha256" },
        "environmentProgramSha256": { "$ref": "#/$defs/sha256" },
        "bindingMode": { "const": "id_and_canonical_json_hash_no_contract_copy" },
        "objectives": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": { "$ref": "#/$defs/objectiveBinding" }
        }
      }
    },
    "artDirection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exteriorRead", "interiorRead", "light", "weather", "materials", "forbidden"],
      "properties": {
        "exteriorRead": { "type": "array", "minItems": 3, "items": { "type": "string" } },
        "interiorRead": { "type": "array", "minItems": 3, "items": { "type": "string" } },
        "light": { "type": "array", "minItems": 2, "items": { "type": "string" } },
        "weather": { "type": "array", "minItems": 2, "items": { "type": "string" } },
        "materials": { "type": "array", "minItems": 4, "items": { "type": "string" } },
        "forbidden": { "type": "array", "minItems": 4, "items": { "type": "string" } }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "vector3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "type": "number" }
    },
    "anchorPlacement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["anchorId", "portId", "localCoordinateMeters", "macroRoomId", "placementKind"],
      "properties": {
        "anchorId": { "type": "string", "pattern": "^anchor\\.warden_reed_four_bank_visibility\\." },
        "portId": { "type": "string", "pattern": "^port\\.warden-reed\\." },
        "localCoordinateMeters": { "$ref": "#/$defs/vector3" },
        "macroRoomId": { "type": ["string", "null"] },
        "placementKind": { "enum": ["room_port", "interior_egress_vertex", "external_destination"] }
      }
    },
    "directedEdgeBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["edgeId", "sourceFromAnchorId", "sourceToAnchorId"],
      "properties": {
        "edgeId": { "type": "string", "pattern": "^edge\\.v6\\.warden_reed_four_bank_visibility\\." },
        "sourceFromAnchorId": { "type": "string" },
        "sourceToAnchorId": { "type": "string" }
      }
    },
    "localRoomSegment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fromRoomId", "toRoomId"],
      "properties": {
        "fromRoomId": { "type": "string" },
        "toRoomId": { "type": "string" }
      }
    },
    "sourceSegment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["edgeId", "fromPortId", "toPortId"],
      "properties": {
        "edgeId": { "type": "string", "pattern": "^edge\\.v6\\.warden_reed_four_bank_visibility\\." },
        "fromPortId": { "type": "string" },
        "toPortId": { "type": "string" }
      }
    },
    "sourceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "sha256", "bytes", "selector", "recordSha256", "authority"],
      "properties": {
        "id": { "type": "string" },
        "path": { "type": "string", "pattern": "^(?![A-Za-z]:|/|.*\\\\).+$" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "bytes": { "type": "integer", "minimum": 1 },
        "selector": { "type": "string", "minLength": 1 },
        "recordSha256": { "$ref": "#/$defs/sha256" },
        "authority": { "enum": ["canon", "authored_design_constraint", "accepted_quest_contract"] }
      }
    },
    "room": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "kind", "localCentroidMeters", "level", "clearHeightMeters", "capacity", "materials", "uses", "sensory"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "kind": { "type": "string" },
        "localCentroidMeters": { "$ref": "#/$defs/vector3" },
        "level": { "type": "string" },
        "clearHeightMeters": { "type": "number", "exclusiveMinimum": 0 },
        "capacity": { "type": "integer", "minimum": 1 },
        "materials": { "type": "array", "minItems": 3, "items": { "type": "string" } },
        "uses": { "type": "array", "minItems": 2, "items": { "type": "string" } },
        "sensory": {
          "type": "object",
          "additionalProperties": false,
          "required": ["visual", "acoustic", "scent"],
          "properties": {
            "visual": { "type": "string" },
            "acoustic": { "type": "string" },
            "scent": { "type": "string" }
          }
        }
      }
    },
    "structure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "classification", "typologyBindingId", "boundsLocalMeters", "structure", "exterior", "weathering", "rooms"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "classification": { "type": "string" },
        "typologyBindingId": { "type": ["string", "null"] },
        "boundsLocalMeters": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minimum", "maximum"],
          "properties": {
            "minimum": { "$ref": "#/$defs/vector3" },
            "maximum": { "$ref": "#/$defs/vector3" }
          }
        },
        "structure": { "type": "string" },
        "exterior": { "type": "array", "minItems": 4, "items": { "type": "string" } },
        "weathering": { "type": "array", "minItems": 3, "items": { "type": "string" } },
        "rooms": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": { "$ref": "#/$defs/room" }
        }
      }
    },
    "threshold": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "fromRoomId", "to", "fromPortId", "toPortId", "kind", "clearWidthMeters", "sillLocalElevationMeters", "stateRule", "sourceBindingId", "sourceDirectedEdgeBindings"],
      "properties": {
        "id": { "type": "string" },
        "fromRoomId": { "type": ["string", "null"] },
        "to": { "type": ["string", "null"] },
        "fromPortId": { "type": ["string", "null"] },
        "toPortId": { "type": ["string", "null"] },
        "kind": { "type": "string" },
        "clearWidthMeters": { "type": "number", "exclusiveMinimum": 0 },
        "sillLocalElevationMeters": { "type": "number" },
        "stateRule": { "type": "string" },
        "sourceBindingId": { "type": ["string", "null"] },
        "sourceDirectedEdgeBindings": {
          "type": "array",
          "maxItems": 2,
          "items": { "$ref": "#/$defs/directedEdgeBinding" }
        }
      }
    },
    "egressPath": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "destinationAnchorId", "anchorIds", "thresholdIds", "routeId", "failureDomainId", "minimumClearWidthMeters", "stepFree", "sourcePathId", "sourceForwardEdgeIds", "sourceReturnEdgeIds"],
      "properties": {
        "id": { "type": "string" },
        "destinationAnchorId": { "type": "string" },
        "anchorIds": { "type": "array", "minItems": 3, "items": { "type": "string" } },
        "thresholdIds": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "routeId": { "type": "string" },
        "failureDomainId": { "type": "string" },
        "minimumClearWidthMeters": { "const": 2.2 },
        "stepFree": { "type": "boolean" },
        "sourcePathId": { "type": "string" },
        "sourceForwardEdgeIds": { "type": "array", "minItems": 2, "items": { "type": "string" } },
        "sourceReturnEdgeIds": { "type": "array", "minItems": 2, "items": { "type": "string" } }
      }
    },
    "utility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "sourceRoomId", "terminalRoomIds", "maintenanceRouteIds", "phaseAvailability", "failureState", "sourceEndpointBinding"],
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string" },
        "sourceRoomId": { "type": "string" },
        "terminalRoomIds": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "maintenanceRouteIds": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "phaseAvailability": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "failureState": { "type": "string" },
        "sourceEndpointBinding": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "recordSha256"],
              "properties": {
                "id": { "type": "string" },
                "recordSha256": { "$ref": "#/$defs/sha256" }
              }
            }
          ]
        }
      }
    },
    "hazard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sourceHazardId", "affectedRoomIds", "activePhaseIds", "readableCues", "avoidanceRouteIds", "failureMutation"],
      "properties": {
        "id": { "type": "string" },
        "sourceHazardId": { "type": "string" },
        "affectedRoomIds": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "activePhaseIds": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "readableCues": { "type": "array", "minItems": 2, "items": { "type": "string" } },
        "avoidanceRouteIds": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "failureMutation": { "type": "string" }
      }
    },
    "habitat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sourceHabitatId", "occupantIds", "roomIds", "phaseIds", "environment", "exclusionRules"],
      "properties": {
        "id": { "type": "string" },
        "sourceHabitatId": { "type": "string" },
        "occupantIds": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "roomIds": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "phaseIds": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "environment": { "type": "array", "minItems": 3, "items": { "type": "string" } },
        "exclusionRules": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "topology", "roomIds", "localRoomSegments", "sourceSegments", "widthMeters", "surface", "phaseAvailability", "accessibility"],
      "properties": {
        "id": { "type": "string" },
        "role": { "type": "string" },
        "topology": { "type": "string" },
        "roomIds": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "localRoomSegments": { "type": "array", "items": { "$ref": "#/$defs/localRoomSegment" } },
        "sourceSegments": { "type": "array", "items": { "$ref": "#/$defs/sourceSegment" } },
        "widthMeters": { "type": "number", "exclusiveMinimum": 0 },
        "surface": { "type": "string" },
        "phaseAvailability": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "accessibility": { "type": "string" }
      }
    },
    "activityPhase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "canonicalPhaseId", "density", "activities", "activeRouteIds", "staffedRoomIds", "visualState", "acousticState", "scentState"],
      "properties": {
        "id": { "type": "string" },
        "canonicalPhaseId": { "enum": ["first_light", "day", "fog_fall", "night"] },
        "density": { "type": "string" },
        "activities": { "type": "array", "minItems": 3, "items": { "type": "string" } },
        "activeRouteIds": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "staffedRoomIds": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "visualState": { "type": "string" },
        "acousticState": { "type": "string" },
        "scentState": { "type": "string" }
      }
    },
    "objectiveBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objectiveId", "sourceEndpointSha256", "localEvidenceRoomIds", "requiredLocalRouteIds", "phaseId"],
      "properties": {
        "objectiveId": { "type": "string" },
        "sourceEndpointSha256": { "$ref": "#/$defs/sha256" },
        "localEvidenceRoomIds": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "requiredLocalRouteIds": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "phaseId": { "enum": ["first_light", "day", "fog_fall", "night"] }
      }
    }
  }
}
